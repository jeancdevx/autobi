# Database Configuration
# Use Aiven with SSL: set MYSQL_SSL=true and MYSQL_SSL_CA=ca.pem
# Use local MySQL only: leave MYSQL_SSL unset or false and use localhost/3306
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=autobi_user
MYSQL_PASSWORD=your_secure_password_here
MYSQL_ROOT_PASSWORD=root_secure_password_here
MYSQL_STAR_SCHEMA=autobi_warehouse
MYSQL_SSL=false
MYSQL_SSL_CA=your_ca_certificate.pem